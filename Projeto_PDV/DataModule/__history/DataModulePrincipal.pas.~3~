unit DataModulePrincipal;

interface

uses
  System.SysUtils, System.Classes, FireDAC.Stan.Intf, FireDAC.Stan.Option,
  FireDAC.Stan.Error, FireDAC.UI.Intf, FireDAC.Phys.Intf, FireDAC.Stan.Def,
  FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys, FireDAC.Phys.PG,
  FireDAC.Phys.PGDef, FireDAC.VCLUI.Wait, FireDAC.Stan.Param, FireDAC.DatS,
  FireDAC.DApt.Intf, FireDAC.DApt, Data.DB, FireDAC.Comp.DataSet,
  FireDAC.Comp.Client;

type
  TdtmPrincipal = class(TDataModule)
    dtsCliente: TDataSource;
    fdConnection: TFDConnection;
    fdDriverLink: TFDPhysPgDriverLink;
    fdTableCliente: TFDTable;
    fdTableEndereco: TFDTable;
    fdTableProduto: TFDTable;
    fdTableProdutoid: TIntegerField;
    fdTableProdutodescricao: TWideStringField;
    fdTableProdutopreco: TBCDField;
    fdTableProdutoestoque: TIntegerField;
  private
    { Private declarations }
  public
    { Public declarations }
    function Conectar: Boolean;
    function IdGerado(ATabela: TFDTable): Integer;
  end;

var
  dtmPrincipal: TdtmPrincipal;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}

{$R *.dfm}


uses
  System.UITypes,
  Vcl.Dialogs;

function TdtmPrincipal.Conectar: Boolean;
begin
  try
    fdConnection.Connected := True;

    // O master (cliente) abre antes do detalhe (endereco).
    fdTableCliente.Open;
    fdTableEndereco.Open;
    fdTableProduto.Open;
    // A venda (master) abre antes dos itens (detalhe).
    //fdTableVenda.Open;
    //fdTableItemVenda.Open;

    Result := True;
  except
    on E: Exception do
    begin
      MessageDlg('Não foi possível conectar ao banco de dados:' + sLineBreak +
        E.Message, mtError, [mbOK], 0);
      Result := False;
    end;
  end;
end;

function TdtmPrincipal.IdGerado(ATabela: TFDTable): Integer;
begin
  Result := ATabela.FieldByName('id').AsInteger;
  if Result > 0 then
    Exit;

  // O id (SERIAL) foi criado pelo PostgreSQL, mas o registro em memoria
  // ainda esta sem ele. Pega o ultimo id gerado nesta conexao...
  Result := fdConnection.ExecSQLScalar('SELECT lastval()');

  // ...e recarrega a tabela para o registro ficar completo.
  ATabela.Refresh;
  ATabela.Locate('id', Result, []);
end;

end.
